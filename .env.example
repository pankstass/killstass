# scripts/init-env.sh writes real random secrets locally. Do not commit .env.
APP_HOST=192.168.1.250
APP_ORIGIN=https://192.168.1.250
BIND_IP=192.168.1.250
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
CHALLENGE_TTL_HOURS=48
# v1.2: срок кода приглашения и лимит неначатых матчей на аккаунт
INVITE_TTL_HOURS=12
MAX_OPEN_SETUPS=10
POSTGRES_IMAGE=postgres:16-alpine
PYTHON_IMAGE=python:3.12-slim-bookworm
CADDY_IMAGE=caddy:2.10.0-alpine
# v1.10: срок одноразового кода сброса пароля (#admin, scripts/admin.sh password LOGIN), минуты
RESET_TTL_MINUTES=60
# v1.10, всё ниже необязательно. Почти всё записывают скрипты; вручную — только ACME_EMAIL и ACME_DNS_PROVIDER для cert.sh:
# scripts/domain.sh set killstass.su — домен рядом с адресом по IP; APP_ORIGIN получает оба адреса
#KS_DOMAIN=killstass.su
#KS_TLS_MODE=internal          # internal — сертификат внутреннего CA; files — Let's Encrypt (scripts/cert.sh)
#KS_ALLOW_NETS="192.168.1.0/24"  # кого пускают прокси и firewall.sh; scripts/tailscale.sh добавляет 100.64.0.0/10
# scripts/cert.sh: учётная запись Let's Encrypt и код DNS-провайдера lego (ключи API — в local/acme.env)
#ACME_EMAIL=admin@example.org
#ACME_DNS_PROVIDER=regru
# scripts/push.sh enable mailto:… — Web Push (контейнер pushworker, профиль push)
#PUSH_ENABLED=1
#PUSH_CONTACT=mailto:admin@example.org
#PUSH_HTTPS_PROXY=
# Профили docker compose: push, tailscale (scripts/push.sh, scripts/tailscale.sh)
#COMPOSE_PROFILES=push,tailscale
#TS_HOSTNAME=killstass
