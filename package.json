{
  "name": "killstass-devtools",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "description": "Developer tooling only (lint, formatting, browser e2e/accessibility tests). Production images do not use Node.",
  "scripts": {
    "lint": "eslint web tests/e2e eslint.config.js && prettier --check \"web/*.js\" \"web/*.css\" \"tests/e2e/*.mjs\"",
    "format": "prettier --write \"web/*.js\" \"web/*.css\" \"tests/e2e/*.mjs\"",
    "e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:unit": "node --test tests/e2e/unit.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
