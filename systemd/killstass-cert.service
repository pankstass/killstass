[Unit]
Description=killstass Let's Encrypt certificate renewal (DNS-01, scripts/cert.sh)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/killstass/local/acme.env
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/killstass
ExecStart=/opt/killstass/scripts/cert.sh renew
TimeoutStartSec=30min
Nice=10
UMask=0077
